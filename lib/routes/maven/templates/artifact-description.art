<div>
  <dl>
    <dt>{{ description }}</dt>
    
    <dt>GroupID:{{ groupId }}</dt>
    
    <dt>ArtifactID:{{ artifactId }}</dt>
    
    <dt>Version:{{ version }}</dt>
    
    <dt>打包类型:{{ packaging }}</dt>
    
    <dt>许可证:{{ licenses }}</dt>
  </dl>

  <p><a href="https://repo1.maven.org/maven2/{{ groupIdPath }}/{{ artifactId }}/{{ version }}/">构件存档文件</a></p>
  
  <p><a href="https://repo1.maven.org/maven2/{{ groupIdPath }}/{{ artifactId }}/{{ version }}/{{ artifactId }}-{{ version }}.pom">查看POM</a></p>
  
  <p><a href="https://mvnrepository.com/artifact/{{ groupId }}/{{ artifactId }}/{{ version }}">MvnRepository中查看此构件</a></p>
  
  <p><a href="https://central.sonatype.com/artifact/{{ groupId }}/{{ artifactId }}/{{ version }}/dependents">{{ dependencyOfCount }}个构件正在使用</a></p>
    
  <p><a href="https://central.sonatype.com/artifact/{{ groupId }}/{{ artifactId }}/{{ version }}/dependencies">依赖{{ dependentOnCount }}个构件</a></p>
</div>